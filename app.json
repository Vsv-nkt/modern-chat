{
  "expo": {
    "name": "modern-chat",
    "slug": "modern-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "modernchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Додатку Modern Chat потрібен доступ до мікрофона для запису голосових повідомлень."
      },
      "icon": "./assets/expo.icon"
    },
    "android": {
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Додатку Modern Chat потрібен доступ до мікрофона для запису голосових повідомлень."
        }
      ]
    ]
  }
}
