{
  "expo": {
    "name": "modern-chat",
    "slug": "modern-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "modernchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Додатку Modern Chat потрібен доступ до мікрофона для запису голосових повідомлень.",
        "NSCameraUsageDescription": "Modern Chat потрібен доступ до камери для запису відеокружечків."
      },
      "icon": "./assets/expo.icon"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nikita2009.modernchat"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Додатку Modern Chat потрібен доступ до мікрофона для запису голосових повідомлень."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Modern Chat потрібен доступ до камери для запису відеокружечків.",
          "microphonePermission": "Modern Chat потрібен доступ до мікрофона для запису звуку у відеокружечках."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d06db2a-cd9c-4485-9298-fbb16a8fc686"
      }
    },
    "owner": "nikita2009"
  }
}
